{
  "name": "@cynco/mcp",
  "version": "2.0.0",
  "description": "Cynco Accounting MCP Server — AI-native accounting tools via Model Context Protocol",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/cynco-labs/cynco-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/cynco-labs/cynco-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/cynco-labs/cynco-mcp/issues"
  },
  "bin": {
    "cynco-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build:apps": "tsx build-apps.ts",
    "build": "npm run build:apps && tsc && node -e \"require('fs').chmodSync('dist/index.js', '755')\"",
    "dev": "tsx src/index.ts",
    "dev:http": "MCP_TRANSPORT=http tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:load": "tsx tests/load/load-test.ts",
    "generate-key": "tsx src/cli/generate-key.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "pg": "^8.13.1",
    "typeid-js": "^1.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^4.1.7",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-singlefile": "^2.3.2",
    "vitest": "^4.1.7"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": ">=1.19.13",
      "brace-expansion": ">=5.0.6",
      "fast-uri": ">=3.1.2",
      "hono": ">=4.12.18",
      "ip-address": ">=10.1.1",
      "path-to-regexp": ">=8.4.0",
      "picomatch": ">=4.0.4",
      "postcss": ">=8.5.10",
      "qs": ">=6.15.2",
      "uuid": "11.1.1"
    }
  }
}
